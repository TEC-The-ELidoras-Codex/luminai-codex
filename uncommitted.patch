+        }
+
+    def load_personas(self) -> Dict[str, Any]:
+        # Minimal persona registry
+        return {"luminai": {"role": "Sentinel"}}
+
+    # --------------------- Context ops ---------------------
+    def fetch_context(self) -> CopilotContext:
