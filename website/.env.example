# Local development environment variables for website/
# Copy this to .env.local and customize as needed

# Backend API URL (FastAPI resonance platform)
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket URL (if different from API URL)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Environment
NODE_ENV=development

# Feature flags
NEXT_PUBLIC_ENABLE_NOTEBOOK_VIEWER=true
NEXT_PUBLIC_ENABLE_SPOTIFY_INTEGRATION=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Optional: Analytics/telemetry
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_POSTHOG_KEY=
